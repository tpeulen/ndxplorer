{
 "title": "UMAP Computation Progress",
 "sections": [
  {"type": "custom", "key": "code_editor", "target": "log_text", "options": {"height": 330, "read_only": true}},
  {"type": "progress", "attr": "progress_fraction", "text_source": "status"},
